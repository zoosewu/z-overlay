import {
    Button,
    CheckBox,
    ComboBox,
    LineEdit,
    ListView,
    Palette,
    StandardListView,
    TabWidget,
} from "std-widgets.slint";
import { Tray } from "tray.slint";
import { Editor, GroupRow, OverlayEditor, OverlayRow } from "editor.slint";

export { Tray, Editor, GroupRow, OverlayRow }

export enum PromptKind {
    closed,
    load-failed,
    save-failed,
    refresh-failed,
    startup-failed,
    image-failed,
    open-failed,
    identity-empty,
    identity-duplicate,
    confirm-edit,
    confirm-remove,
}

export struct ManagedEntry {
    label: string,
    overlays: int,
    groups: int,
}

export component MainWindow inherits Window {
    title: "z-overlay";
    icon: @image-url("../assets/z-overlay.png");
    preferred-width: 1180px;
    preferred-height: 780px;
    min-width: 960px;
    min-height: 640px;

    in property <[ManagedEntry]> managed-apps;
    in-out property <int> managed-current: -1;
    in property <string> active-name;
    in-out property <bool> start-with-windows;
    in-out property <bool> start-minimized;
    in-out property <int> language-index;
    in property <string> settings-folder;

    in-out property <bool> overlay-editor-open;

    in-out property <bool> app-dialog-open;
    in property <bool> app-dialog-editing;
    in-out property <string> app-dialog-name;
    in-out property <string> app-dialog-identity;
    in property <[StandardListViewItem]> running-apps;
    in-out property <int> running-current: -1;

    in-out property <PromptKind> prompt: PromptKind.closed;
    in property <string> prompt-detail;

    callback add-clicked();
    callback edit-clicked(row: int);
    callback overlays-clicked(row: int);
    callback remove-clicked(row: int);
    callback running-selected(index: int);
    callback refresh-running();
    callback app-dialog-saved();
    callback prompt-accepted(kind: PromptKind);
    callback prompt-canceled(kind: PromptKind);
    callback start-with-windows-toggled(enabled: bool);
    callback start-minimized-toggled(enabled: bool);
    callback language-selected(index: int);
    callback open-settings-folder();

    pure function summary(entry: ManagedEntry) -> string {
        return @tr("{n} overlay" | "{n} overlays" % entry.overlays) + " · " + @tr("{n} group" | "{n} groups" % entry.groups);
    }

    pure function prompt-message(kind: PromptKind, detail: string) -> string {
        if kind == PromptKind.load-failed {
            return @tr("Could not load settings. Using defaults.\n\n{}", detail);
        }
        if kind == PromptKind.save-failed {
            return @tr("Could not save settings.\n\n{}", detail);
        }
        if kind == PromptKind.refresh-failed {
            return @tr("Could not refresh running applications.\n\n{}", detail);
        }
        if kind == PromptKind.startup-failed {
            return @tr("Could not update Windows startup.\n\n{}", detail);
        }
        if kind == PromptKind.image-failed {
            return @tr("Could not add the image.\n\n{}", detail);
        }
        if kind == PromptKind.open-failed {
            return @tr("Could not open the folder.\n\n{}", detail);
        }
        if kind == PromptKind.identity-empty {
            return @tr("Enter an application path or executable name, or select a running application.");
        }
        if kind == PromptKind.identity-duplicate {
            return @tr("That application is already configured.");
        }
        if kind == PromptKind.confirm-edit {
            return @tr("Save changes to {}?", detail);
        }
        if kind == PromptKind.confirm-remove {
            return @tr("Remove {}?", detail);
        }
        return "";
    }

    pure function prompt-accept-text(kind: PromptKind) -> string {
        if kind == PromptKind.confirm-edit {
            return @tr("Save");
        }
        if kind == PromptKind.confirm-remove {
            return @tr("Remove");
        }
        return @tr("OK");
    }

    pure function prompt-is-question(kind: PromptKind) -> bool {
        return kind == PromptKind.confirm-edit || kind == PromptKind.confirm-remove;
    }

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        TabWidget {
            vertical-stretch: 1;

            Tab {
                title: @tr("Applications");

                HorizontalLayout {
                    padding: 12px;
                    spacing: 12px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 12px;

                            Text {
                                text: @tr("Name");
                                color: Palette.foreground;
                                font-weight: 600;
                                horizontal-stretch: 1;
                            }

                            Text {
                                width: 240px;
                                text: @tr("Overlays");
                                color: Palette.foreground;
                                font-weight: 600;
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            border-color: Palette.border;
                            border-width: 1px;
                            border-radius: 4px;

                            ListView {
                                x: 1px;
                                y: 1px;
                                width: parent.width - 2px;
                                height: parent.height - 2px;

                                for entry[index] in root.managed-apps: Rectangle {
                                    height: 36px;
                                    background: index == root.managed-current ? Palette.selection-background : transparent;

                                    TouchArea {
                                        clicked => {
                                            root.managed-current = index;
                                        }
                                        double-clicked => {
                                            root.managed-current = index;
                                            root.overlays-clicked(index);
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 11px;
                                        padding-right: 11px;
                                        spacing: 12px;

                                        Text {
                                            text: entry.label;
                                            color: index == root.managed-current ? Palette.selection-foreground : Palette.foreground;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }

                                        Text {
                                            width: 240px;
                                            text: root.summary(entry);
                                            color: index == root.managed-current ? Palette.selection-foreground : Palette.foreground;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 8px;
                        alignment: start;

                        Button {
                            text: @tr("Add…");
                            clicked => {
                                root.add-clicked();
                            }
                        }

                        Button {
                            text: @tr("Overlays…");
                            primary: true;
                            enabled: root.managed-current >= 0;
                            clicked => {
                                root.overlays-clicked(root.managed-current);
                            }
                        }

                        Button {
                            text: @tr("Edit…");
                            enabled: root.managed-current >= 0;
                            clicked => {
                                root.edit-clicked(root.managed-current);
                            }
                        }

                        Button {
                            text: @tr("Remove");
                            enabled: root.managed-current >= 0;
                            clicked => {
                                root.remove-clicked(root.managed-current);
                            }
                        }
                    }
                }
            }

            Tab {
                title: @tr("Settings");

                VerticalLayout {
                    padding: 12px;
                    spacing: 12px;
                    alignment: start;

                    CheckBox {
                        text: @tr("Start with Windows");
                        checked <=> root.start-with-windows;
                        toggled => {
                            root.start-with-windows-toggled(self.checked);
                        }
                    }

                    // Indented to line up with the check box label above.
                    HorizontalLayout {
                        padding-left: 28px;

                        CheckBox {
                            text: @tr("Start minimized to the tray");
                            enabled: root.start-with-windows;
                            checked <=> root.start-minimized;
                            toggled => {
                                root.start-minimized-toggled(self.checked);
                            }
                        }
                    }

                    Text {
                        text: @tr("Language");
                        color: Palette.foreground;
                    }

                    HorizontalLayout {
                        alignment: start;

                        // Fixed height: the combo box otherwise reports its drop-down
                        // list as part of its preferred height.
                        ComboBox {
                            min-width: 220px;
                            height: 32px;
                            model: [@tr("System default"), "English", "繁體中文"];
                            current-index <=> root.language-index;
                            selected(value) => {
                                root.language-selected(self.current-index);
                            }
                        }
                    }

                    Text {
                        text: @tr("Settings folder");
                        color: Palette.foreground;
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        LineEdit {
                            horizontal-stretch: 1;
                            read-only: true;
                            text: root.settings-folder;
                        }

                        Button {
                            text: @tr("Open");
                            clicked => {
                                root.open-settings-folder();
                            }
                        }
                    }
                }
            }
        }

        Text {
            text: root.active-name == "" ? @tr("No managed application in front") : @tr("Showing overlays for {}", root.active-name);
            color: Palette.foreground;
            overflow: elide;
        }
    }

    if root.overlay-editor-open: OverlayEditor { }

    if root.app-dialog-open: Rectangle {
        background: #00000080;

        TouchArea {
            scroll-event(event) => {
                return EventResult.accept;
            }
        }

        Rectangle {
            width: min(parent.width - 48px, 680px);
            height: min(parent.height - 48px, 600px);
            background: Palette.background;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 8px;

            VerticalLayout {
                padding: 20px;
                spacing: 16px;

                Text {
                    text: root.app-dialog-editing ? @tr("Edit application") : @tr("Add application");
                    color: Palette.foreground;
                    font-size: 16px;
                    font-weight: 600;
                    vertical-stretch: 0;
                }

                // Only the list of running applications takes up spare height.
                VerticalLayout {
                    spacing: 6px;
                    vertical-stretch: 1;

                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: @tr("Running applications (window title — application path)");
                            color: Palette.foreground;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }

                        Button {
                            text: @tr("Refresh");
                            clicked => {
                                root.refresh-running();
                            }
                        }
                    }

                    StandardListView {
                        min-height: 96px;
                        vertical-stretch: 1;
                        model: root.running-apps;
                        current-item <=> root.running-current;
                        current-item-changed(index) => {
                            root.running-selected(index);
                        }
                    }
                }

                VerticalLayout {
                    spacing: 6px;
                    vertical-stretch: 0;

                    Text {
                        text: @tr("Display name (optional)");
                        color: Palette.foreground;
                    }

                    LineEdit {
                        text <=> root.app-dialog-name;
                    }
                }

                VerticalLayout {
                    spacing: 6px;
                    vertical-stretch: 0;

                    Text {
                        text: @tr("Application path or executable name");
                        color: Palette.foreground;
                    }

                    LineEdit {
                        text <=> root.app-dialog-identity;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    vertical-stretch: 0;

                    Button {
                        text: @tr("Save");
                        primary: true;
                        clicked => {
                            root.app-dialog-saved();
                        }
                    }

                    Button {
                        text: @tr("Cancel");
                        clicked => {
                            root.app-dialog-open = false;
                        }
                    }
                }
            }
        }
    }

    if root.prompt != PromptKind.closed: Rectangle {
        background: #00000080;

        TouchArea {
            scroll-event(event) => {
                return EventResult.accept;
            }
        }

        Rectangle {
            width: min(parent.width - 48px, 460px);
            height: prompt-layout.preferred-height;
            background: Palette.background;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 8px;

            prompt-layout := VerticalLayout {
                padding: 16px;
                spacing: 16px;

                Text {
                    text: root.prompt-message(root.prompt, root.prompt-detail);
                    color: Palette.foreground;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Button {
                        text: root.prompt-accept-text(root.prompt);
                        primary: true;
                        clicked => {
                            root.prompt-accepted(root.prompt);
                        }
                    }

                    if root.prompt-is-question(root.prompt): Button {
                        text: @tr("Cancel");
                        clicked => {
                            root.prompt-canceled(root.prompt);
                        }
                    }
                }
            }
        }
    }
}
