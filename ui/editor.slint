import {
    Button,
    CheckBox,
    ComboBox,
    LineEdit,
    ListView,
    Palette,
} from "std-widgets.slint";

// One line of the hierarchy: the "No group" heading, a group, or an overlay.
export struct TreeRow {
    // 0: no-group heading, 1: group, 2: overlay.
    kind: int,
    // The group's index for a group, the overlay's index for an overlay.
    index: int,
    // An overlay in a group sits one level in.
    nested: bool,
    name: string,
    enabled: bool,
    // Group only: its number, its number's hotkey, and whether it is held.
    number: int,
    hotkey: string,
    hold: bool,
}

export struct OverlayRow {
    name: string,
    enabled: bool,
    preview: image,
    // Position and size in pixels of the preview frame.
    x: float,
    y: float,
    width: float,
    height: float,
    opacity: float,
    failed: bool,
}

// The overlay editor's state; Rust keeps it in sync with the settings.
export global Editor {
    in property <string> title;
    in property <[TreeRow]> rows;
    // Preview of every overlay, by overlay index.
    in property <[OverlayRow]> overlays;
    // The selected overlay's index.
    in-out property <int> selected: -1;
    in property <int> preview-width: 1920;
    in property <int> preview-height: 1080;
    in-out property <int> preview-index;
    in property <bool> on-screen;
    out property <string> on-screen-hint: @tr("Drag to move · Right-click for details · Esc to finish");

    callback close();
    callback preview-selected(index: int);
    callback toggle-on-screen();
    callback select(overlay: int);
    // Opens the details of an overlay next to the pointer.
    callback inspect(overlay: int);
    callback enabled-toggled(overlay: int, enabled: bool);
    callback add-text(name: string);
    callback add-image();
    callback add-group(name: string);
    callback duplicate(overlay: int);
    callback remove(overlay: int);
    // An overlay was dragged in the preview; (x, y) is its new top-left corner.
    callback dragged(overlay: int, x: float, y: float);
    // An overlay was dropped in the hierarchy before row `target` (or after the last).
    callback row-dropped(overlay: int, target: int);
    callback group-enabled(group: int, enabled: bool);
    callback group-renamed(group: int, name: string);
    callback group-number(group: int, number: int);
    callback group-mode-toggled(group: int);
    callback remove-group(group: int);
}

component Canvas inherits Rectangle {
    background: Palette.alternate-background;
    border-radius: 6px;
    clip: true;

    property <float> k: min((self.width - 32px) / (Editor.preview-width * 1px), (self.height - 32px) / (Editor.preview-height * 1px));

    frame := Rectangle {
        width: Editor.preview-width * 1px * root.k;
        height: Editor.preview-height * 1px * root.k;
        background: #1b1d22;
        border-width: 1px;
        border-color: Palette.foreground.with-alpha(0.25);

        TouchArea {
            clicked => {
                Editor.select(-1);
            }
        }

        for row[index] in Editor.overlays: Rectangle {
            property <length> dx;
            property <length> dy;
            x: row.x * 1px * root.k + self.dx;
            y: row.y * 1px * root.k + self.dy;
            width: max(row.width * 1px * root.k, 4px);
            height: max(row.height * 1px * root.k, 4px);

            Image {
                width: parent.width;
                height: parent.height;
                source: row.preview;
                image-fit: fill;
                opacity: row.enabled ? row.opacity : row.opacity * 0.35;
            }

            if row.failed: Rectangle {
                background: #e0303040;
                border-width: 1px;
                border-color: #e03030;
            }

            if index == Editor.selected: Rectangle {
                x: -2px;
                y: -2px;
                width: parent.width + 4px;
                height: parent.height + 4px;
                border-width: 2px;
                border-color: Palette.accent-background;
            }

            TouchArea {
                mouse-cursor: move;
                pointer-event(event) => {
                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                        Editor.select(index);
                        Editor.inspect(index);
                        return;
                    }
                    if event.button != PointerEventButton.left {
                        return;
                    }
                    if event.kind == PointerEventKind.down {
                        Editor.select(index);
                    } else if event.kind == PointerEventKind.up && (parent.dx != 0 || parent.dy != 0) {
                        Editor.dragged(index, row.x + parent.dx / 1px / root.k, row.y + parent.dy / 1px / root.k);
                        parent.dx = 0;
                        parent.dy = 0;
                    }
                }
                moved => {
                    if self.pressed {
                        parent.dx += self.mouse-x - self.pressed-x;
                        parent.dy += self.mouse-y - self.pressed-y;
                    }
                }
            }
        }
    }
}

component RowButton inherits Button {
    height: 26px;
}

component Hierarchy inherits Rectangle {
    // Rows are this tall, so a drag can tell which row the pointer is over.
    property <length> row-height: 36px;
    // The row a dragged overlay would land before, or -1.
    property <int> drop-target: -1;
    // The overlay being dragged, or -1.
    property <int> dragging: -1;

    border-color: Palette.border;
    border-width: 1px;
    border-radius: 4px;

    ListView {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;

        for row[position] in Editor.rows: Rectangle {
            height: root.row-height;
            background: row.kind == 2 && row.index == Editor.selected ? Palette.selection-background : transparent;

            // A line where the dragged overlay will land.
            if position == root.drop-target && position > 0: Rectangle {
                y: 0;
                height: 2px;
                background: Palette.accent-background;
            }
            if position == Editor.rows.length - 1 && root.drop-target == Editor.rows.length: Rectangle {
                y: parent.height - 2px;
                height: 2px;
                background: Palette.accent-background;
            }

            // Overlays are picked up and dropped; groups and the heading only receive them.
            touch := TouchArea {
                enabled: row.kind == 2;
                pointer-event(event) => {
                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                        Editor.select(row.index);
                        Editor.inspect(row.index);
                    } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                        Editor.select(row.index);
                    } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                        if root.dragging >= 0 && root.drop-target >= 0 {
                            Editor.row-dropped(root.dragging, root.drop-target);
                        }
                        root.dragging = -1;
                        root.drop-target = -1;
                    }
                }
                moved => {
                    if self.pressed && (root.dragging >= 0 || abs(self.mouse-y - self.pressed-y) > 6px) {
                        root.dragging = row.index;
                        root.drop-target = max(1, min(Editor.rows.length, position + floor(self.mouse-y / root.row-height + 0.5)));
                    }
                }
            }

            HorizontalLayout {
                padding-left: row.nested ? 32px : 10px;
                padding-right: 8px;
                spacing: 6px;

                if row.kind == 0: Text {
                    text: @tr("No group");
                    color: Palette.foreground;
                    opacity: 0.7;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                if row.kind == 1: CheckBox {
                    checked: row.enabled;
                    toggled => {
                        Editor.group-enabled(row.index, self.checked);
                    }
                }

                if row.kind == 1: ComboBox {
                    width: 64px;
                    height: 28px;
                    model: ["1", "2", "3", "4", "5", "6", "7", "8", "9"];
                    current-index: row.number - 1;
                    selected => {
                        Editor.group-number(row.index, self.current-index + 1);
                    }
                }

                if row.kind == 1: LineEdit {
                    min-width: 80px;
                    height: 28px;
                    horizontal-stretch: 1;
                    text: row.name;
                    edited(value) => {
                        Editor.group-renamed(row.index, value);
                    }
                }

                if row.kind == 1: Text {
                    text: row.hotkey;
                    color: Palette.foreground;
                    opacity: 0.7;
                    vertical-alignment: center;
                }

                if row.kind == 1: RowButton {
                    width: 72px;
                    text: row.hold ? @tr("Hold") : @tr("Toggle");
                    clicked => {
                        Editor.group-mode-toggled(row.index);
                    }
                }

                if row.kind == 1: RowButton {
                    text: @tr("Delete");
                    clicked => {
                        Editor.remove-group(row.index);
                    }
                }

                if row.kind == 2: CheckBox {
                    checked: row.enabled;
                    toggled => {
                        Editor.enabled-toggled(row.index, self.checked);
                    }
                }

                if row.kind == 2: Text {
                    text: row.name;
                    color: row.index == Editor.selected ? Palette.selection-foreground : Palette.foreground;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                if row.kind == 2: RowButton {
                    text: @tr("Copy");
                    clicked => {
                        Editor.duplicate(row.index);
                    }
                }

                if row.kind == 2: RowButton {
                    text: @tr("Delete");
                    clicked => {
                        Editor.remove(row.index);
                    }
                }
            }
        }
    }
}

export component OverlayEditor inherits Rectangle {
    background: Palette.background;

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 12px;

            Button {
                text: @tr("‹ Back");
                clicked => {
                    Editor.close();
                }
            }

            Text {
                text: Editor.title;
                color: Palette.foreground;
                font-size: 16px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            // Fixed height: the combo box otherwise reports its drop-down
            // list as part of its preferred height.
            ComboBox {
                width: 170px;
                height: 32px;
                model: ["1280 × 720", "1920 × 1080", "2560 × 1440", "3440 × 1440", "3840 × 2160"];
                current-index <=> Editor.preview-index;
                selected => {
                    Editor.preview-selected(self.current-index);
                }
            }

            Button {
                text: Editor.on-screen ? @tr("Done") : @tr("Edit on screen");
                primary: true;
                clicked => {
                    Editor.toggle-on-screen();
                }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 460px;
                spacing: 8px;

                Hierarchy {
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    spacing: 6px;

                    Button {
                        horizontal-stretch: 1;
                        text: @tr("+ Text");
                        clicked => {
                            Editor.add-text(@tr("Text"));
                        }
                    }

                    Button {
                        horizontal-stretch: 1;
                        text: @tr("+ Image…");
                        clicked => {
                            Editor.add-image();
                        }
                    }

                    Button {
                        horizontal-stretch: 1;
                        text: @tr("+ Group");
                        clicked => {
                            Editor.add-group(@tr("Group"));
                        }
                    }
                }
            }

            Canvas {
                horizontal-stretch: 1;
            }
        }
    }
}
